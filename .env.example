# LLM: anthropic (padrão) | openrouter. Com openrouter, os modelos usam o nome do OpenRouter
# (ex.: google/gemini-2.5-flash) e a chave vai em OPENROUTER_API_KEY.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL_MAIN=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-5-5
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave da API do Supabase. Para ler o schema `externo` por REST precisa ser a SECRETA
# (sb_secret_...) ou service_role, só no backend. A publishable/anon NÃO lê o schema.
SUPABASE_KEY=
CORS_ORIGINS=http://localhost:3000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=negocio-de-pe
PERSISTENCE=memory                     # memory | postgres
KG_VERSION=latest
DEMO_MODE=false
ENRICHMENT_TIMEOUT_S=5
ENABLE_DEV_ROUTES=true

# Dados externos (schema `externo`): ver docs/DADOS_EXTERNOS.md
EXTERNAL_DATA_MODE=auto            # auto | sql | rest
EXTERNAL_DATA_CACHE_TTL_S=2592000  # 30 dias
EXTERNAL_DATA_DIR=                 # pasta com registros_desastres.zip e dados-crime-no-brasil-por-uf.xlsx
